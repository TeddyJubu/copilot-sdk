#!/bin/sh
#
# Gitleaks + Lint-Staged Pre-Commit Hook
#

# Add homebrew to PATH for non-interactive shells
export PATH="${PNPM_HOME:-$HOME/Library/pnpm}:/opt/homebrew/bin:$PATH"

echo "🔍 Running Gitleaks to check for secrets..."

# Check if gitleaks is installed
if ! command -v gitleaks >/dev/null 2>&1; then
    echo ""
    echo "❌ ERROR: Gitleaks is not installed!"
    echo ""
    echo "To install gitleaks:"
    echo "  macOS:   brew install gitleaks"
    echo "  Linux:   https://github.com/gitleaks/gitleaks#installing"
    echo ""
    exit 1
fi

# Run gitleaks on staged changes
if ! gitleaks git --staged --redact=100 --ignore-gitleaks-allow --config=.gitleaks.toml; then
    echo ""
    echo "❌ COMMIT BLOCKED: Secret scan failed or found private data."
    echo ""
    echo "To fix:"
    echo "  1. Remove sensitive data from staged files"
    echo "  2. Use .env.example instead of .env files"
    echo "  3. Add false positives to .gitleaks.toml allowlist"
    echo ""
    exit 1
fi

echo "✅ Gitleaks scan passed!"
echo ""

# Run lint-staged
pnpm exec lint-staged
